# Copy to .env.local and fill in. PRD §12.
# Never commit .env.local. SUPABASE_SERVICE_ROLE_KEY must never reach the client bundle.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (P1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lead notifications (P4)
RESEND_API_KEY=
LEAD_NOTIFY_EMAILS=

# Rate limiting on lead endpoints (P4)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin publish → revalidate (P10)
REVALIDATE_SECRET=

# Analytics & contact
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_PHONE=+919999999999

# WhatsApp Cloud API (optional, P4)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
